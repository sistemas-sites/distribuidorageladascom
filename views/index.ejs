     <script>
         function showMessage(message, type = 'success') {
             const messageBox = document.getElementById('messageBox');
             messageBox.textContent = message;
             messageBox.className = `message ${type}`;
             messageBox.style.display = 'block';
 
             setTimeout(() => {
                 messageBox.style.display = 'none';
             }, 3000);
         }
 
         function baterPonto(tipo) {
             const form = document.getElementById('pontoForm');
             const funcionario_id = form.funcionario_id.value;
 
             const data = { funcionario_id };
 
             fetch(`/ponto/${tipo}`, {
                 method: 'POST',
                 headers: {
                     'Content-Type': 'application/json'
                 },
                 body: JSON.stringify(data)
             })
             .then(response => response.json())
             .then(result => showMessage(result.message))
             .catch(error => showMessage(error.message, 'error'));
         }
 
        // ===================== RELATÓRIO =====================
        // Todo o cálculo (virada de dia, janta de 30 min, adicional noturno
        // e meta de horas) vem pronto do servidor em /relatorio.

        let relatorioAtual = null;

        function mesAtualISO() {
            const hoje = new Date();
            return hoje.getFullYear() + '-' + String(hoje.getMonth() + 1).padStart(2, '0');
        }

        function formatarHoras(minutos) {
            const sinal = minutos < 0 ? '-' : '';
            const total = Math.round(Math.abs(minutos || 0));
            return sinal + Math.floor(total / 60) + 'h ' + String(total % 60).padStart(2, '0') + 'm';
        }

        function alternarPeriodoLivre() {
            const bloco = document.getElementById('periodoLivre');
            const visivel = bloco.style.display !== 'none';
            bloco.style.display = visivel ? 'none' : 'block';
            document.getElementById('btnPeriodoLivre').textContent =
                visivel ? 'Usar período personalizado' : 'Ocultar período personalizado';
        }

        // Botão principal: gera o mês inteiro do funcionário selecionado,
        // já com faltas e folgas.
        function gerarRelatorioDoMes() {
            const funcionario_id = document.getElementById('funcionario_id_relatorio').value;
            const campoMes = document.getElementById('mes_relatorio');

            if (!funcionario_id) {
                alert('Selecione o funcionário.');
                return;
            }
            if (!campoMes.value) campoMes.value = mesAtualISO();

            buscarRelatorio({ funcionario_id: funcionario_id, mes: campoMes.value });
        }

        // Período personalizado (mantido para consultas fora do mês fechado)
        function gerarRelatorio() {
            const funcionario_id = document.getElementById('funcionario_id_relatorio').value;
            const data_inicio = document.getElementById('data_inicio').value;
            const data_fim = document.getElementById('data_fim').value;

            if (!data_inicio || !data_fim) {
                alert('Informe a data de início e a data de fim.');
                return;
            }
            if (data_inicio > data_fim) {
                alert('A data de início não pode ser maior que a data de fim.');
                return;
            }

            buscarRelatorio({ funcionario_id: funcionario_id, data_inicio: data_inicio, data_fim: data_fim });
        }

        function buscarRelatorio(filtros) {
            const meta = document.getElementById('meta_horas').value;
            const params = new URLSearchParams(filtros);
            if (meta) params.set('meta_horas', meta);

            fetch('/relatorio?' + params.toString())
                .then(resposta => resposta.json().then(corpo => {
                    if (!resposta.ok) throw new Error(corpo.error || 'Erro ao obter o relatório');
                    return corpo;
                }))
                .then(dados => {
                    relatorioAtual = dados;
                    exibirRelatorio(dados);
                })
                .catch(erro => {
                    console.error('Erro ao gerar relatório:', erro);
                    alert(erro.message);
                });
        }

        const ROTULO_DIA = {
            'DOMINGO': 'Dom', 'SEGUNDA-FEIRA': 'Seg', 'TERCA-FEIRA': 'Ter', 'QUARTA-FEIRA': 'Qua',
            'QUINTA-FEIRA': 'Qui', 'SEXTA-FEIRA': 'Sex', 'SABADO': 'Sáb'
        };

        const COR_STATUS = {
            'FOLGA': '#d9f2d9',
            'FALTA': '#ffe0e0',
            'ATESTADO': '#e3ecff',
            'FERIADO': '#e3ecff',
            'FERIAS': '#e3ecff',
            'PREVISTO': '#f2f2f2'
        };

        function exibirRelatorio(dados) {
            const corpo = document.querySelector('#tabelaRelatorio tbody');
            const corpoNoturno = document.querySelector('#tabelaNoturno tbody');
            corpo.innerHTML = '';
            corpoNoturno.innerHTML = '';

            document.getElementById('relatorioResultado').style.display = 'block';
            document.getElementById('tituloRelatorio').textContent =
                'Relatório de ' + dados.funcionario.nome +
                ' — ' + formatarPeriodo(dados.periodo);

            // ---- Tabela principal, dia a dia ----
            dados.pontos.forEach(ponto => {
                const linha = document.createElement('tr');
                if (COR_STATUS[ponto.status]) linha.style.backgroundColor = COR_STATUS[ponto.status];
                else if (ponto.inconsistente) linha.style.backgroundColor = '#fff0cc';

                const saldo = ponto.status === 'PREVISTO' ? '--' : formatarHoras(ponto.saldoMinutos);
                const classeSaldo = ponto.saldoMinutos < 0 ? 'saldo-negativo' : 'saldo-positivo';

                const celulas = [
                    ponto.dataBR,
                    ROTULO_DIA[ponto.diaSemana] || ponto.diaSemana,
                    ponto.entrada,
                    ponto.saida_almoco,
                    ponto.volta_almoco,
                    ponto.saida,
                    ponto.minutosTrabalhados ? formatarHoras(ponto.minutosTrabalhados) : '--'
                ];

                celulas.forEach(valor => {
                    const td = document.createElement('td');
                    td.textContent = valor;
                    linha.appendChild(td);
                });

                const tdSaldo = document.createElement('td');
                tdSaldo.textContent = saldo;
                if (ponto.status !== 'PREVISTO') tdSaldo.className = classeSaldo;
                linha.appendChild(tdSaldo);

                const tdStatus = document.createElement('td');
                tdStatus.textContent = ponto.status;
                if (ponto.observacao) tdStatus.title = ponto.observacao;
                linha.appendChild(tdStatus);

                // Ação: a folga da semana não é fixa, então o dia que caiu como
                // FALTA pode ser convertido em FOLGA (e a folga não vale -8h).
                const tdAcao = document.createElement('td');
                if (ponto.status !== 'PREVISTO') {
                    const botao = document.createElement('button');
                    botao.type = 'button';
                    botao.className = 'btn-mini';
                    if (ponto.tipoManual) {
                        botao.textContent = 'Desfazer';
                        botao.onclick = () => marcarTipoDia(ponto.data, null);
                    } else {
                        botao.textContent = 'Marcar folga';
                        botao.onclick = () => marcarTipoDia(ponto.data, 'FOLGA');
                    }
                    tdAcao.appendChild(botao);
                } else {
                    tdAcao.textContent = '--';
                }
                linha.appendChild(tdAcao);

                corpo.appendChild(linha);
            });

            // ---- Resumo do mês ----
            const t = dados.totais;
            const resumo = [
                ['Total trabalhado', formatarHoras(t.minutosTrabalhados), ''],
                ['Carga horária do mês', formatarHoras(t.metaMinutos), ''],
                ['Horas extras', formatarHoras(t.horasExtrasMinutos), t.horasExtrasMinutos > 0 ? 'positivo' : ''],
                ['Horas devidas', formatarHoras(t.horasDevidasMinutos), t.horasDevidasMinutos > 0 ? 'negativo' : ''],
                ['Saldo do mês', formatarHoras(t.saldoMinutos), t.saldoMinutos < 0 ? 'negativo' : 'positivo'],
                ['Soma dos saldos diários', formatarHoras(t.somaSaldosDiarios), t.somaSaldosDiarios < 0 ? 'negativo' : 'positivo'],
                ['Adicional noturno', formatarHoras(t.minutosNoturnos), ''],
                ['Dias trabalhados', String(t.diasTrabalhados), ''],
                ['Faltas', String(t.faltas), t.faltas > 0 ? 'negativo' : ''],
                ['Folgas', String(t.folgas), ''],
                ['Dias abonados', String(t.abonados), '']
            ];

            document.getElementById('resumoRelatorio').innerHTML = resumo.map(item =>
                '<div class="resumo-item"><span class="resumo-rotulo">' + item[0] + '</span>' +
                '<span class="resumo-valor ' + (item[2] === 'negativo' ? 'saldo-negativo' : item[2] === 'positivo' ? 'saldo-positivo' : '') + '">' +
                item[1] + '</span></div>'
            ).join('');

            // ---- Tabela de adicional noturno ----
            if (!dados.noturnos.length) {
                const vazia = document.createElement('tr');
                vazia.innerHTML = '<td colspan="5">Nenhuma hora na faixa noturna neste período.</td>';
                corpoNoturno.appendChild(vazia);
            } else {
                dados.noturnos.forEach(n => {
                    const linha = document.createElement('tr');
                    [n.dataBR, ROTULO_DIA[n.diaSemana] || n.diaSemana, n.entrada, n.saida, formatarHoras(n.minutosNoturnos)]
                        .forEach(valor => {
                            const td = document.createElement('td');
                            td.textContent = valor;
                            linha.appendChild(td);
                        });
                    corpoNoturno.appendChild(linha);
                });
            }

            const totalNoturno = document.createElement('tr');
            totalNoturno.innerHTML =
                '<td colspan="4"><strong>Total de adicional noturno</strong></td>' +
                '<td><strong>' + formatarHoras(t.minutosNoturnos) + '</strong></td>';
            corpoNoturno.appendChild(totalNoturno);

            const totalComNoturno = document.createElement('tr');
            totalComNoturno.innerHTML =
                '<td colspan="4"><strong>Total trabalhado + adicional noturno</strong></td>' +
                '<td><strong>' + formatarHoras(t.minutosComAdicionalNoturno) + '</strong></td>';
            corpoNoturno.appendChild(totalComNoturno);
        }

        function formatarPeriodo(periodo) {
            if (periodo.mes) {
                const [ano, mes] = periodo.mes.split('-');
                const nomes = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho',
                               'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
                return nomes[Number(mes) - 1] + '/' + ano;
            }
            return periodo.data_inicio.split('-').reverse().join('/') + ' a ' +
                   periodo.data_fim.split('-').reverse().join('/');
        }

        // Marca o dia como folga (ou desfaz) e recarrega o relatório
        function marcarTipoDia(data, tipo) {
            if (!relatorioAtual) return;
            const funcionario_id = relatorioAtual.funcionario.id;

            fetch('/ponto/tipo-dia', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ funcionario_id: funcionario_id, data: data, tipo_dia: tipo })
            })
                .then(resposta => resposta.json().then(corpo => {
                    if (!resposta.ok) throw new Error(corpo.error || 'Erro ao marcar o dia');
                    return corpo;
                }))
                .then(corpo => {
                    showMessage(corpo.message);
                    const periodo = relatorioAtual.periodo;
                    buscarRelatorio(periodo.mes
                        ? { funcionario_id: funcionario_id, mes: periodo.mes }
                        : { funcionario_id: funcionario_id, data_inicio: periodo.data_inicio, data_fim: periodo.data_fim });
                })
                .catch(erro => {
                    console.error(erro);
                    alert(erro.message);
                });
        }

        // Planilha .xlsx já formatada, montada no servidor com os mesmos
        // filtros do relatório que está na tela.
        function exportarRelatorioExcel() {
            if (!relatorioAtual) {
                alert('Gere o relatório antes de exportar.');
                return;
            }

            const periodo = relatorioAtual.periodo;
            const params = new URLSearchParams({ funcionario_id: relatorioAtual.funcionario.id });
            if (periodo.mes) {
                params.set('mes', periodo.mes);
            } else {
                params.set('data_inicio', periodo.data_inicio);
                params.set('data_fim', periodo.data_fim);
            }
            params.set('meta_horas', relatorioAtual.regras.metaHoras);

            window.location.href = '/relatorio/exportar?' + params.toString();
        }

        function exportarRelatorioParaCSV() {
            if (!relatorioAtual) {
                alert('Gere o relatório antes de exportar.');
                return;
            }

            const escapar = valor => '"' + String(valor).replace(/"/g, '""') + '"';
            const linhas = [];

            linhas.push(['Funcionário', relatorioAtual.funcionario.nome].map(escapar).join(';'));
            linhas.push(['Período', formatarPeriodo(relatorioAtual.periodo)].map(escapar).join(';'));
            linhas.push('');
            linhas.push(['Data', 'Dia', 'Entrada', 'Saída Janta', 'Volta Janta', 'Saída',
                         'Trabalhado', 'Saldo do dia', 'Adicional Noturno', 'Status', 'Observação']
                        .map(escapar).join(';'));

            relatorioAtual.pontos.forEach(p => {
                linhas.push([
                    p.dataBR, p.diaSemana, p.entrada, p.saida_almoco, p.volta_almoco, p.saida,
                    formatarHoras(p.minutosTrabalhados),
                    p.status === 'PREVISTO' ? '--' : formatarHoras(p.saldoMinutos),
                    formatarHoras(p.minutosNoturnos),
                    p.status, p.observacao || ''
                ].map(escapar).join(';'));
            });

            const t = relatorioAtual.totais;
            linhas.push('');
            linhas.push(['RESUMO'].map(escapar).join(';'));
            [
                ['Total trabalhado', formatarHoras(t.minutosTrabalhados)],
                ['Carga horária do mês', formatarHoras(t.metaMinutos)],
                ['Horas extras', formatarHoras(t.horasExtrasMinutos)],
                ['Horas devidas', formatarHoras(t.horasDevidasMinutos)],
                ['Saldo do mês', formatarHoras(t.saldoMinutos)],
                ['Soma dos saldos diários', formatarHoras(t.somaSaldosDiarios)],
                ['Adicional noturno (total)', formatarHoras(t.minutosNoturnos)],
                ['Total + adicional noturno', formatarHoras(t.minutosComAdicionalNoturno)],
                ['Dias trabalhados', t.diasTrabalhados],
                ['Faltas', t.faltas],
                ['Folgas', t.folgas],
                ['Dias abonados', t.abonados]
            ].forEach(item => linhas.push(item.map(escapar).join(';')));

            // BOM para o Excel abrir os acentos corretamente
            const blob = new Blob(['﻿' + linhas.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.setAttribute('download', 'relatorio-' + relatorioAtual.funcionario.id + '-' +
                (relatorioAtual.periodo.mes || relatorioAtual.periodo.data_inicio) + '.csv');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

